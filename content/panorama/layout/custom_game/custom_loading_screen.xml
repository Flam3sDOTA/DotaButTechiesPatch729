<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c" />
		<include src="file://{resources}/styles/custom_game/custom_loading_screen.css" />
	</styles>
	 <scripts>
        <include src="file://{resources}/scripts/custom_game/custom_loading_screen.js" />
    </scripts>
	<Panel class="LoadingScreenRoot">
		
		<Panel id="OptionList">
			<Panel id="OptionListGroup">
			<Label id="OptionTitle" text="#VoteOptions" />
			<Panel id="OptionDivider" />
				<Panel id="Options">
					<ToggleButton id="force_techies" class="VoteToggle" text="#ForceTechies" onactivate="VoteOptionClicked('force_techies')" />
					<ToggleButton id="random_techies" class="VoteToggle" text="#RandomTechies" onactivate="VoteOptionClicked('random_techies')" />
					<Panel class="GroupDivider" />
					<ToggleButton id="turbo_mode" class="VoteToggle" text="#ForceTurboMode" onactivate="VoteOptionClicked('turbo_mode')" />
					<ToggleButton id="turbo_mode_full" class="VoteToggle" text="#ForceFullTurboMode" onactivate="VoteOptionClicked('turbo_mode_full')" />
					<Panel class="GroupDivider" />
					<ToggleButton id="swap_blast_off" class="VoteToggle" text="#SwapBlastOff" onactivate="VoteOptionClicked('swap_blast_off')" />
					<ToggleButton id="swap_red_mines" class="VoteToggle" text="#SwapRedMines" onactivate="VoteOptionClicked('swap_red_mines')" />
					<ToggleButton id="fill_bots" class="VoteToggle" text="#FillBots" onactivate="VoteOptionClicked('fill_bots')" />
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>